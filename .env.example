# Firebase (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 👑 Subscription/License system (MASTER-only admin feature)
# DEFAULT OFF — company apps (A Coy/bcoy...) me KUCH likhne ki zaroorat NAHI.
# Sirf MASTER (F Coy) ki .env me ye line:
# VITE_SUBSCRIPTION_ENABLED=true

# ─────────────────────────────────────────────
# AI Agent — Local ERP commands work WITHOUT any cloud AI keys.
#
# 🔒 SECURITY: production AI secrets live in Firebase Cloud Functions
# (see functions/README.md). The browser calls callable functions and NEVER
# sees GROQ_API_KEY / GEMINI_API_KEY / PINECONE_API_KEY / PINECONE_HOST.
# Set those with `firebase functions:secrets:set ...`, NOT here.
#
# Frontend AI config (all optional / non-secret):
#   VITE_FUNCTIONS_REGION=us-central1   # region of deployed functions
#   VITE_USE_FUNCTIONS_EMULATOR=false   # true = talk to local emulator
#   VITE_AI_PROXY_URL=                  # alternative REST proxy URL (advanced)
#
# DEV ONLY: bundled browser keys are used ONLY by a local `vite` dev server
# with an explicit opt-in. They are never read in a production build and
# Pinecone never accepts a browser key.
#   VITE_AI_ALLOW_BROWSER_KEYS=false
#   VITE_GROQ_API_KEY=
#   VITE_GEMINI_API_KEY=
# ─────────────────────────────────────────────
VITE_FUNCTIONS_REGION=us-central1
VITE_USE_FUNCTIONS_EMULATOR=false
VITE_AI_PROXY_URL=

# Dev-only browser keys (keep blank in production)
VITE_AI_ALLOW_BROWSER_KEYS=false
VITE_GROQ_API_KEY=
VITE_GROQ_API_KEY_2=
VITE_GROQ_API_KEY_3=
VITE_GROQ_MODEL=llama-3.3-70b-versatile

VITE_GEMINI_API_KEY=
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_MODEL=gemini-flash-latest

# RAG/vector search — runs through the callable functions; no browser secret.
VITE_AI_ENABLE_PINECONE=false

# Optional feature flags
VITE_AI_ENABLE_LOCAL_ERP=true
VITE_AI_ENABLE_CACHE=true
VITE_AI_ENABLE_GROQ=true
VITE_AI_ENABLE_GEMINI=true
