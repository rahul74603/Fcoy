# Firebase (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 👑 Subscription/License system (MASTER-only admin feature)
# DEFAULT OFF — company apps (A Coy/bcoy...) me KUCH likhne ki zaroorat NAHI.
# Sirf MASTER (F Coy) ki .env me ye line:
# VITE_SUBSCRIPTION_ENABLED=true

# ─────────────────────────────────────────────
# AI Agent — Local ERP commands work WITHOUT any cloud AI keys.
#
# 🔒 SECURITY: VITE_* values are BUNDLED INTO THE BROWSER and visible to
# every visitor of the deployed site. Do NOT put production Groq/Gemini/
# Pinecone SECRET keys in VITE_ vars for a public deployment.
#
# PRODUCTION: deploy the small AI proxy (Cloud Function / server) that
# keeps the real keys server-side, and point the app at it:
#   VITE_AI_PROXY_URL=https://your-region-your-project.cloudfunctions.net/aiProxy
# The browser then sends no secret key. Pinecone is ONLY usable via proxy.
#
# The VITE_*_API_KEY vars below are for LOCAL DEV / single-owner self-hosted
# use only.
# ─────────────────────────────────────────────
VITE_AI_PROXY_URL=

VITE_GROQ_API_KEY=
VITE_GROQ_API_KEY_2=
VITE_GROQ_API_KEY_3=
VITE_GROQ_MODEL=llama-3.3-70b-versatile

VITE_GEMINI_API_KEY=
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_MODEL=gemini-flash-latest

# Optional RAG / vector search. Requires the proxy (secret stays server-side).
VITE_AI_ENABLE_PINECONE=false
VITE_PINECONE_API_KEY=
VITE_PINECONE_HOST=

# Optional feature flags
VITE_AI_ENABLE_LOCAL_ERP=true
VITE_AI_ENABLE_CACHE=true
VITE_AI_ENABLE_GROQ=true
VITE_AI_ENABLE_GEMINI=true
