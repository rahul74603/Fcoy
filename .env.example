# Firebase (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI Agent — Local ERP commands work without cloud AI keys.
# Add one or more keys for natural language fallback.
VITE_GROQ_API_KEY=
VITE_GROQ_API_KEY_2=
VITE_GROQ_API_KEY_3=
VITE_GROQ_MODEL=llama-3.3-70b-versatile

VITE_GEMINI_API_KEY=
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_MODEL=gemini-2.5-flash-lite

# Optional RAG / vector search. Keep disabled unless configured.
VITE_AI_ENABLE_PINECONE=false
VITE_PINECONE_API_KEY=
VITE_PINECONE_HOST=

# Optional feature flags
VITE_AI_ENABLE_LOCAL_ERP=true
VITE_AI_ENABLE_CACHE=true
VITE_AI_ENABLE_GROQ=true
VITE_AI_ENABLE_GEMINI=true
