rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleIs(role) {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function canManage() {
      return roleIs('Company Commander') || roleIs('Clerk');
    }

    // Subject Master and staff assignments are used by the training administration screens.
    // All authenticated staff may view them; only CC and Clerk may modify them.
    match /subject_master/{id} {
      allow read: if signedIn();
      allow create, update, delete: if canManage();
    }
    match /staff_subjects/{id} {
      allow read: if signedIn();
      allow create, update, delete: if canManage();
    }
    match /activity_logs/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    // Existing ERP modules use many legacy collections. Keep the application
    // operational for authenticated staff while those modules are migrated to
    // collection-specific role rules.
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
